# Environment template. Copy to `.env` and adjust. Never commit `.env`.

# --- Postgres ---
POSTGRES_USER=hookguard
POSTGRES_PASSWORD=hookguard
POSTGRES_DB=hookguard
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=hookguard
RABBITMQ_PASSWORD=hookguard
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Application hosts ---
API_PORT=8080
FAKE_MERCHANT_PORT=9000
ASPNETCORE_ENVIRONMENT=Development

# --- HookGuard ---
# Key used to encrypt per-source and per-destination signing secrets at rest (phase 3).
# Development default only; supply a real secret from a secret store in production.
HOOKGUARD_ENCRYPTION_KEY=dev-only-change-me
